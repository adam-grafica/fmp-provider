# FMP configuration — copy to .env and fill in. NEVER commit .env.
# cp .env.example .env
#
# FMP is a private experimental inference adapter. Default deployment is
# localhost-only. Do not send secrets or sensitive data to unverified
# upstreams. See docs/security.md.

# --- bind (localhost-only default) ---
FMP_HOST=127.0.0.1
FMP_PORT=2089
# Refuse startup on non-localhost bind unless this is explicitly true.
# Setting it true prints a documented warning every boot.
FMP_ALLOW_PUBLIC_BIND=false

# --- auth (api_key default) ---
FMP_AUTH_MODE=api_key
# Comma-separated keys. Empty = local-open mode (localhost only).
# Generate: node -e "console.log('sk-'+require('crypto').randomBytes(24).toString('hex'))"
FMP_API_KEYS=

# --- logging (sanitized; bodies off by default) ---
FMP_LOG_LEVEL=info
# Never true with sensitive data: logs request/response bodies.
FMP_LOG_PROMPTS=false

# --- limits ---
FMP_RATE_LIMIT_RPM=30
FMP_MAX_REQUEST_BYTES=10485760
FMP_MAX_RETRIES=5
FMP_UPSTREAM_TIMEOUT_MS=120000

# --- routes (responses experimental, off by default) ---
FMP_ENABLE_OPENAI=true
FMP_ENABLE_ANTHROPIC=true
FMP_ENABLE_RESPONSES=false

# --- tools: transport_only is the ONLY supported value ---
FMP_TOOL_MODE=transport_only

# --- kill switch: comma-separated alias ids, or FMP_KILL_ALL=true ---
FMP_DISABLED_MODELS=
FMP_KILL_ALL=false

# --- CORS deny-by-default (empty = no Access-Control-Allow-Origin header) ---
FMP_CORS_ALLOW_ORIGINS=

# --- upstream override (default: freemodels worker) ---
# FMP_UPSTREAM=https://freemodels-chat.freemodels.workers.dev

# --- legacy tier knobs (optional, backward compatible) ---
# FMP_KEYS=sk-lan:pro,sk-casa:free
# FMP_FREE_RPM=10
# FMP_FREE_CONC=2
# FMP_PRO_RPM=120
# FMP_PRO_CONC=16
# FMP_MAX_TOKENS_CEIL=8192
# FMP_TRACE=

# --- hardening: per-route upstream timeouts (ms, fallback to global) ---
# FMP_TIMEOUT_OPENAI_MS=
# FMP_TIMEOUT_ANTHROPIC_MS=
# FMP_TIMEOUT_RESPONSES_MS=

# --- SSE heartbeat (ms, `: ping` comments keep idle streams alive; 0 disables) ---
FMP_HEARTBEAT_MS=15000

# --- per-harness output token caps (matched on x-harness header, else user-agent) ---
# Format: name:tokens,... Unknown harnesses use the global ceil.
FMP_HARNESS_LIMITS=hermes:8192,opencode:8192,claude-code:4096,antigravity:4096,codex:8192

# --- Claude Code auto-mode safety classifier fast-routing ---
# When Claude Code sends auto-mode security classification sub-requests, reroute
# them to a low-latency model to prevent classifier timeouts.
FMP_CLASSIFIER_MODEL=claude-fable-5
FMP_CLASSIFIER_MATCH="security monitor,safety classifier"
